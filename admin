<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ADMIN ENTERPRISE | PORTAL ABSENSI</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
body{
margin:0;
font-family:'Segoe UI',sans-serif;
background:linear-gradient(135deg,#0d6efd,#4dabf7);
display:flex;
justify-content:center;
align-items:center;
height:100vh;
overflow:hidden;
}

.app{
width:100%;
max-width:420px;
height:100vh;
background:linear-gradient(160deg,#0d6efd,#74c0fc);
border-radius:30px;
box-shadow:0 20px 60px rgba(0,0,0,0.4);
overflow:hidden;
position:relative;
display:flex;
flex-direction:column;
}

.header{
padding:15px;
color:white;
text-align:center;
font-weight:700;
position:relative;
}

.logout{
position:absolute;
right:15px;
top:15px;
font-size:12px;
cursor:pointer;
}

.menu{
display:flex;
overflow-x:auto;
background:rgba(255,255,255,0.15);
}

.menu button{
flex:1;
border:none;
padding:10px;
font-size:12px;
background:transparent;
color:white;
}

.menu button.active{
background:white;
color:#0d6efd;
font-weight:600;
}

.content{
flex:1;
overflow-y:auto;
padding:15px;
}

.glass{
background:rgba(255,255,255,0.2);
backdrop-filter:blur(15px);
border-radius:20px;
padding:15px;
margin-bottom:15px;
color:white;
box-shadow:0 10px 30px rgba(0,0,0,0.3);
}

input,select{
border-radius:10px !important;
}

table{
font-size:11px;
}

.hidden{display:none;}
</style>
</head>

<body>

<div class="app">

<div class="header">
ADMIN DASHBOARD
<div class="logout" onclick="logout()">Logout</div>
</div>

<div class="menu">
<button onclick="showTab('siswa')" id="btnSiswa" class="active">Siswa</button>
<button onclick="showTab('guru')" id="btnGuru">Guru</button>
<button onclick="showTab('setting')" id="btnSetting">Setting</button>
<button onclick="showTab('rekap')" id="btnRekap">Rekap</button>
</div>

<div class="content">

<!-- ================= SISWA ================= -->
<div id="siswa">

<div class="glass">
<h6>Tambah / Edit Siswa</h6>

<input type="hidden" id="idSiswa">

<input class="form-control mb-2" id="nisn" placeholder="NISN">
<input class="form-control mb-2" id="nama" placeholder="Nama">
<input class="form-control mb-2" id="kelas" placeholder="Kelas">
<input class="form-control mb-2" id="ortu" placeholder="Nama Orang Tua">
<input class="form-control mb-2" id="hp" placeholder="No HP">
<input class="form-control mb-2" id="tahun" placeholder="Tahun Masuk">
<input class="form-control mb-2" id="wali" placeholder="Wali Kelas">

<button class="btn btn-success w-100" onclick="saveSiswa()">SIMPAN</button>
</div>

<div class="glass">
<h6>Data Siswa</h6>
<table class="table table-sm table-bordered bg-white text-dark">
<thead><tr><th>Nama</th><th>Aksi</th></tr></thead>
<tbody id="tabelSiswa"></tbody>
</table>
</div>

</div>

<!-- ================= GURU ================= -->
<div id="guru" class="hidden">

<div class="glass">
<h6>Tambah / Edit Guru</h6>

<input type="hidden" id="idGuru">

<input class="form-control mb-2" id="nip" placeholder="NIP">
<input class="form-control mb-2" id="namaGuru" placeholder="Nama Guru">
<input class="form-control mb-2" id="mapel" placeholder="Mapel">
<input class="form-control mb-2" id="tugas" placeholder="Tugas Tambahan">
<input class="form-control mb-2" id="hpGuru" placeholder="No HP">
<input class="form-control mb-2" id="passGuru" placeholder="Password">
<input class="form-control mb-2" id="statusGuru" placeholder="Status">

<button class="btn btn-success w-100" onclick="saveGuru()">SIMPAN</button>
</div>

<div class="glass">
<h6>Data Guru</h6>
<table class="table table-sm table-bordered bg-white text-dark">
<thead><tr><th>Nama</th><th>Aksi</th></tr></thead>
<tbody id="tabelGuru"></tbody>
</table>
</div>

</div>

<!-- ================= SETTING ================= -->
<div id="setting" class="hidden">

<div class="glass">
<h6>Setting GPS & Waktu</h6>

<input class="form-control mb-2" id="lat" placeholder="Latitude">
<input class="form-control mb-2" id="lng" placeholder="Longitude">
<input class="form-control mb-2" id="radius" placeholder="Radius (meter)">
<input class="form-control mb-2" id="jamMasuk" placeholder="Jam Masuk">
<input class="form-control mb-2" id="batasTelat" placeholder="Batas Telat">
<input class="form-control mb-2" id="jamPulang" placeholder="Jam Pulang">
<input class="form-control mb-2" id="batasAkhir" placeholder="Batas Akhir Pulang">

<button class="btn btn-primary w-100" onclick="saveSetting()">SIMPAN SETTING</button>
</div>

</div>

<!-- ================= REKAP ================= -->
<div id="rekap" class="hidden">

<div class="glass">
<h6>Rekap Harian</h6>
<input type="date" id="tgl">
<button class="btn btn-primary w-100 mt-2" onclick="rekapHarian()">Tampilkan</button>
</div>

<div class="glass">
<h6>Rekap Bulanan</h6>
<input type="month" id="bln">
<button class="btn btn-primary w-100 mt-2" onclick="rekapBulanan()">Tampilkan</button>
</div>

<div class="glass">
<h6>Hasil Rekap</h6>
<div id="hasilRekap" style="font-size:11px;"></div>
<button class="btn btn-danger w-100 mt-2" onclick="downloadPDF()">Download PDF</button>
</div>

</div>

</div>
</div>

<script>

const API_URL="PASTE_URL_WEB_APP_ANDA";

/* ================= PROTEKSI ================= */
let session=JSON.parse(localStorage.getItem("portalAbsensiSession"));
if(!session || session.role!=="admin"){
alert("Akses ditolak");
window.location.href="index.html";
}

/* ================= MENU ================= */
function showTab(tab){
document.querySelectorAll(".menu button").forEach(b=>b.classList.remove("active"));
document.querySelectorAll(".content > div").forEach(d=>d.classList.add("hidden"));
document.getElementById(tab).classList.remove("hidden");
document.getElementById("btn"+capitalize(tab)).classList.add("active");
}

function capitalize(str){return str.charAt(0).toUpperCase()+str.slice(1);}

/* ================= SISWA ================= */
function loadSiswa(){
let form=new FormData();
form.append("action","getSiswa");
fetch(API_URL,{method:"POST",body:form})
.then(r=>r.json())
.then(data=>{
tabelSiswa.innerHTML="";
data.forEach(d=>{
tabelSiswa.innerHTML+=`
<tr>
<td>${d[2]}</td>
<td>
<button class="btn btn-warning btn-sm" onclick='editSiswa(${JSON.stringify(d)})'>Edit</button>
<button class="btn btn-danger btn-sm" onclick="hapusSiswa('${d[0]}')">Hapus</button>
</td>
</tr>`;
});
});
}

function saveSiswa(){
let f=new FormData();
f.append("action","saveSiswa");
f.append("id",idSiswa.value);
f.append("nisn",nisn.value);
f.append("nama",nama.value);
f.append("kelas",kelas.value);
f.append("ortu",ortu.value);
f.append("hp",hp.value);
f.append("tahun",tahun.value);
f.append("wali",wali.value);

fetch(API_URL,{method:"POST",body:f})
.then(r=>r.json())
.then(res=>{if(res.status){loadSiswa();}});
}

function editSiswa(d){
idSiswa.value=d[0];
nisn.value=d[1];
nama.value=d[2];
kelas.value=d[3];
ortu.value=d[4];
hp.value=d[5];
tahun.value=d[6];
wali.value=d[7];
}

function hapusSiswa(id){
if(!confirm("Hapus?"))return;
let f=new FormData();
f.append("action","deleteSiswa");
f.append("id",id);
fetch(API_URL,{method:"POST",body:f})
.then(r=>r.json())
.then(res=>{if(res.status){loadSiswa();}});
}

/* ================= GURU ================= */
function loadGuru(){
let f=new FormData();
f.append("action","getGuru");
fetch(API_URL,{method:"POST",body:f})
.then(r=>r.json())
.then(data=>{
tabelGuru.innerHTML="";
data.forEach(d=>{
tabelGuru.innerHTML+=`
<tr>
<td>${d[2]}</td>
<td>
<button class="btn btn-warning btn-sm" onclick='editGuru(${JSON.stringify(d)})'>Edit</button>
<button class="btn btn-danger btn-sm" onclick="hapusGuru('${d[0]}')">Hapus</button>
</td>
</tr>`;
});
});
}

function saveGuru(){
let f=new FormData();
f.append("action","saveGuru");
f.append("id",idGuru.value);
f.append("nip",nip.value);
f.append("nama",namaGuru.value);
f.append("mapel",mapel.value);
f.append("tugas",tugas.value);
f.append("hp",hpGuru.value);
f.append("password",passGuru.value);
f.append("status",statusGuru.value);
fetch(API_URL,{method:"POST",body:f})
.then(r=>r.json())
.then(res=>{if(res.status){loadGuru();}});
}

function editGuru(d){
idGuru.value=d[0];
nip.value=d[1];
namaGuru.value=d[2];
mapel.value=d[3];
tugas.value=d[4];
hpGuru.value=d[5];
passGuru.value=d[6];
statusGuru.value=d[7];
}

function hapusGuru(id){
if(!confirm("Hapus?"))return;
let f=new FormData();
f.append("action","deleteGuru");
f.append("id",id);
fetch(API_URL,{method:"POST",body:f})
.then(r=>r.json())
.then(res=>{if(res.status){loadGuru();}});
}

/* ================= SETTING ================= */
function saveSetting(){
let f=new FormData();
f.append("action","saveSetting");
f.append("lat",lat.value);
f.append("lng",lng.value);
f.append("radius",radius.value);
f.append("jamMasuk",jamMasuk.value);
f.append("batasTelat",batasTelat.value);
f.append("jamPulang",jamPulang.value);
f.append("batasAkhir",batasAkhir.value);
fetch(API_URL,{method:"POST",body:f})
.then(r=>r.json())
.then(res=>{if(res.status){alert("Setting disimpan");}});
}

/* ================= REKAP ================= */
function rekapHarian(){
let f=new FormData();
f.append("action","getRekapHarian");
f.append("tanggal",tgl.value);
fetch(API_URL,{method:"POST",body:f})
.then(r=>r.json())
.then(data=>{
hasilRekap.innerHTML=JSON.stringify(data,null,2);
});
}

function rekapBulanan(){
let f=new FormData();
f.append("action","getRekapBulanan");
f.append("bulan",bln.value);
fetch(API_URL,{method:"POST",body:f})
.then(r=>r.json())
.then(data=>{
hasilRekap.innerHTML=JSON.stringify(data,null,2);
});
}

function downloadPDF(){
window.print();
}

/* ================= LOGOUT ================= */
function logout(){
localStorage.clear();
window.location.href="index.html";
}

/* INIT */
loadSiswa();
loadGuru();

</script>

</body>
</html>
