<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ADMIN | PORTAL ABSENSI</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
body{
margin:0;
font-family:'Segoe UI',sans-serif;
display:flex;
justify-content:center;
align-items:center;
background:linear-gradient(135deg,#0d6efd,#4dabf7);
height:100vh;
overflow:hidden;
}

.app{
width:100%;
max-width:420px;
height:100vh;
background:linear-gradient(160deg,#0d6efd,#74c0fc);
border-radius:30px;
box-shadow:0 20px 60px rgba(0,0,0,0.4);
overflow:hidden;
position:relative;
}

.content{
position:absolute;
inset:0;
padding:20px;
overflow-y:auto;
}

.logo{
width:70px;
display:block;
margin:0 auto 10px auto;
}

.title{
text-align:center;
color:white;
font-weight:700;
margin-bottom:15px;
}

.glass{
background:rgba(255,255,255,0.2);
backdrop-filter:blur(15px);
border-radius:20px;
padding:15px;
margin-bottom:15px;
color:white;
box-shadow:0 10px 30px rgba(0,0,0,0.3);
}

input{
border-radius:10px !important;
}

button{
border-radius:10px !important;
}

.table{
font-size:12px;
}

.hidden{
display:none;
}

.logout{
position:absolute;
top:15px;
right:15px;
font-size:12px;
color:white;
cursor:pointer;
}

</style>
</head>

<body>

<div class="app">
<div class="content">

<div class="logout" onclick="logout()">Logout</div>

<img src="logo.png" class="logo">

<div class="title">
DASHBOARD ADMIN<br>
PORTAL ABSENSI
</div>

<!-- FORM SISWA -->
<div class="glass">

<h6>Data Siswa</h6>

<input type="hidden" id="id">

<input class="form-control mb-2" id="nisn" placeholder="NISN">
<input class="form-control mb-2" id="nama" placeholder="Nama Siswa">
<input class="form-control mb-2" id="kelas" placeholder="Kelas">
<input class="form-control mb-2" id="ortu" placeholder="Nama Orang Tua">
<input class="form-control mb-2" id="hp" placeholder="No HP Orang Tua">
<input class="form-control mb-2" id="tahun" placeholder="Tahun Masuk">
<input class="form-control mb-2" id="wali" placeholder="Wali Kelas">

<button class="btn btn-success w-100 mb-2" onclick="save()">SIMPAN</button>

</div>

<!-- TABEL -->
<div class="glass">

<h6>Daftar Siswa</h6>

<table class="table table-sm table-bordered bg-white text-dark">
<thead>
<tr>
<th>Nama</th>
<th>Aksi</th>
</tr>
</thead>
<tbody id="tabel"></tbody>
</table>

</div>

</div>
</div>

<script>

/* ================= PROTEKSI LOGIN ================= */

let session = JSON.parse(localStorage.getItem("portalAbsensiSession"));

if(!session || session.role !== "admin"){
alert("Akses ditolak. Silakan login sebagai Admin.");
window.location.href="index.html";
}

/* ================= API URL ================= */

const API_URL = "PASTE_URL_WEB_APP_ANDA";

/* ================= LOAD DATA ================= */

function load(){

let form=new FormData();
form.append("action","getSiswa");

fetch(API_URL,{method:"POST",body:form})
.then(r=>r.json())
.then(data=>{

tabel.innerHTML="";

data.forEach(d=>{

tabel.innerHTML+=`
<tr>
<td>${d[2]}</td>
<td>
<button class="btn btn-warning btn-sm"
onclick='edit(${JSON.stringify(d)})'>Edit</button>
<button class="btn btn-danger btn-sm"
onclick="hapus('${d[0]}')">Hapus</button>
</td>
</tr>
`;

});

});

}

/* ================= SAVE ================= */

function save(){

let form=new FormData();
form.append("action","saveSiswa");
form.append("id",id.value);
form.append("nisn",nisn.value);
form.append("nama",nama.value);
form.append("kelas",kelas.value);
form.append("ortu",ortu.value);
form.append("hp",hp.value);
form.append("tahun",tahun.value);
form.append("wali",wali.value);

fetch(API_URL,{method:"POST",body:form})
.then(r=>r.json())
.then(res=>{
if(res.status){
alert("Data berhasil disimpan ✅");
clearForm();
load();
}
});

}

/* ================= EDIT ================= */

function edit(d){
id.value=d[0];
nisn.value=d[1];
nama.value=d[2];
kelas.value=d[3];
ortu.value=d[4];
hp.value=d[5];
tahun.value=d[6];
wali.value=d[7];
}

/* ================= DELETE ================= */

function hapus(idv){

if(!confirm("Yakin ingin menghapus?")) return;

let form=new FormData();
form.append("action","deleteSiswa");
form.append("id",idv);

fetch(API_URL,{method:"POST",body:form})
.then(r=>r.json())
.then(res=>{
if(res.status){
load();
}
});

}

/* ================= CLEAR ================= */

function clearForm(){
id.value="";
nisn.value="";
nama.value="";
kelas.value="";
ortu.value="";
hp.value="";
tahun.value="";
wali.value="";
}

/* ================= LOGOUT ================= */

function logout(){
localStorage.clear();
window.location.href="index.html";
}

/* ================= INIT ================= */

load();

</script>

</body>
</html>
